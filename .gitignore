# Configuración y datos de instalación
/config/config.php
/config/config.php.tmp-*
/storage/*.sqlite
/storage/*.sqlite-*
/storage/*.sqlite-wal
/storage/*.sqlite-shm
/storage/sessions/*
!/storage/sessions/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/last-error.log

# Marcador que solo se incluye en el paquete de demostración
/resources/demo/.demo-build

# Dependencias y resultados de desarrollo
/node_modules
/dist/
/coverage/
*.log
.env
.DS_Store
Thumbs.db

# Artefactos temporales
*.tmp
*.zip

# Proyecto de Android: los activos se generan con tools/android/build.mjs
# (se copian a la raíz de assets/, así que se ignora su contenido generado)
/tools/android/app/src/main/assets/
/tools/android/.gradle/
/tools/android/build/
/tools/android/app/build/
/tools/android/local.properties
